{
    "name": "faysal/riven",
    "description": "API docs, a request playground and load tests for Laravel, generated from your routes, FormRequest rules and API Resources.",
    "keywords": [
        "laravel",
        "openapi",
        "api-documentation",
        "load-testing",
        "stress-testing",
        "formrequest",
        "developer-tools"
    ],
    "homepage": "https://github.com/adnan4k/riven",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Faysal Mohammed",
            "homepage": "https://github.com/adnan4k"
        }
    ],
    "support": {
        "issues": "https://github.com/adnan4k/riven/issues",
        "source": "https://github.com/adnan4k/riven"
    },
    "autoload": {
        "psr-4": {
            "Riven\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Riven\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.0",
        "ext-phar": "*",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/process": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0",
        "fakerphp/faker": "^1.23"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riven\\RivenServiceProvider"
            ]
        },
        "class": "Riven\\Composer\\Plugin"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "opis/json-schema": "^2.4",
        "composer/composer": "^2.2"
    }
}
