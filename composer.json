{
    "name": "faysal/riven",
    "description": "A Laravel developer toolkit",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Riven\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Riven\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Riven\\RivenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3"
    }
}
